# =============================================================================
# Central model / dataset configuration
# =============================================================================
# This is the SINGLE source of truth for where the ML dataset and model
# artifacts live. It is consumed by:
#   - ml-service/main.py            (Python FastAPI inference service)
#   - sales-intelligence-backend    (.NET API: DbInitializer, CsvHelper, ForecastService)
#
# All paths are RELATIVE to the directory that contains this file (the
# workspace root). Both the Python and .NET loaders walk up the directory
# tree to find this file, so they resolve the same absolute paths no matter
# what the current working directory is.
#
# To migrate to a new dataset / model set next time, edit the values below
# (and see MODEL_CONFIGURATION.md for the reseed/restart behavior).
# NOTE: These are server-side paths only. They are NEVER exposed to the browser.
# =============================================================================

# ---- Dataset (CSV used to seed the database and train/analyze models) -------
DATASET_PATH=dataset/clean_crm_data.csv

# ---- Directory that holds every model artifact (relative to workspace root) --
MODEL_DIR=dataset

# ---- Model artifact filenames (looked up inside MODEL_DIR) -------------------
# Company revenue (Gradient Boosting, 9 lag/rolling features)
LAG_REVENUE_MODEL=lag_revenue_model.pkl
LAG_REVENUE_FEATURES=lag_revenue_features.pkl

# Company revenue forecast (Holt-Winters / statsmodels, 3-month horizon)
REVENUE_FORECAST_MODEL=revenue_forecast_model.pkl
REVENUE_FORECAST_FALLBACK=revenue_forecast_next_3_months.csv

# Win rate / deal win probability (RandomForest classifier + encoder metadata)
WINRATE_MODEL=winrate_model.pkl
WINRATE_MODEL_COLUMNS=winrate_model_columns.pkl

# Employee performance -> next-quarter revenue (RandomForest, 5 features)
EMPLOYEE_QUARTERLY_MODEL=employee_quarterly_model.pkl
EMPLOYEE_QUARTERLY_FEATURES=employee_quarterly_features.pkl

# Employee revenue -> next-year revenue (Gradient Boosting, 4 features)
EMPLOYEE_YEARLY_MODEL=employee_yearly_model.pkl
EMPLOYEE_YEARLY_FEATURES=employee_yearly_features.pkl
